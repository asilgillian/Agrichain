# Environment variables for artifacts/api-server, unless noted otherwise.
# See docs/bolt-migration.md for what changed and why.

# --- Database (lib/db) ---
# The app reads DATABASE_URL first, falling back to SUPABASE_DB_URL.
# On Bolt, SUPABASE_DB_URL is pre-populated in the host environment.
# To point at a different Postgres, set DATABASE_URL to any standard
# connection string:
#   DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=

# --- Object storage (artifacts/api-server/src/lib) ---
# Supabase Storage S3-compatible endpoint. The access key is your project ref,
# and the secret key is your service role key (SUPABASE_SERVICE_ROLE_KEY is
# pre-populated on Bolt).
S3_ACCESS_KEY_ID=ltjbsvgxkmntiyjhicgt
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://ltjbsvgxkmntiyjhicgt.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Both are "/bucket/prefix" paths inside your Supabase Storage bucket.
PRIVATE_OBJECT_DIR=/agrichain/private
PUBLIC_OBJECT_SEARCH_PATHS=/agrichain/public

# --- Auth (Clerk) ---
CLERK_SECRET_KEY=
# agri-web (Vite): VITE_CLERK_PUBLISHABLE_KEY, VITE_CLERK_PROXY_URL
# agri-mobile (Expo): CLERK_PUBLISHABLE_KEY, CLERK_PROXY_URL (mapped to
#   EXPO_PUBLIC_* by the mobile package's own dev script)

# --- Mobile app reaching the API server (agri-mobile) ---
EXPO_PUBLIC_API_URL=

# --- Mobile money (unchanged) ---
MOMO_ENABLED=false
MOMO_MTN_API_KEY=
MOMO_MTN_API_USER=
MOMO_MTN_BASE_URL=
MOMO_MTN_CALLBACK_URL=
MOMO_MTN_SUBSCRIPTION_KEY=
MOMO_MTN_TARGET_ENV=
MOMO_AIRTEL_BASE_URL=
MOMO_AIRTEL_CLIENT_ID=
MOMO_AIRTEL_CLIENT_SECRET=
MOMO_AIRTEL_COUNTRY=
MOMO_AIRTEL_CURRENCY=
MOMO_AIRTEL_PIN=
MOMO_CALLBACK_SECRET=

# --- Misc ---
LOG_LEVEL=info
NODE_ENV=development
