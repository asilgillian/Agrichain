# Environment variables for artifacts/api-server, unless noted otherwise.
# See docs/bolt-migration.md for what changed and why.

# --- Database (lib/db) ---
# Any standard Postgres connection string works, but the app now connects
# over WebSockets via @neondatabase/serverless rather than raw TCP, so the
# host needs to speak Neon's WebSocket proxy protocol. A Neon project's
# connection string works out of the box:
DATABASE_URL=postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Object storage (artifacts/api-server/src/lib) ---
# Generic S3-compatible config — works with AWS S3, Cloudflare R2, Supabase
# Storage, Backblaze B2, MinIO, etc.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Leave S3_ENDPOINT unset for real AWS S3. Set it for anything else, e.g.:
#   Cloudflare R2:     https://<account_id>.r2.cloudflarestorage.com
#   Supabase Storage:  https://<project_ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=
S3_REGION=auto
# Some providers (MinIO, some R2 setups) need path-style URLs instead of
# virtual-hosted-style (bucket-in-subdomain). Try "true" if uploads 404.
S3_FORCE_PATH_STYLE=false

# Both are "/bucket/prefix" paths inside your bucket — same format as before,
# just no longer requires Replit's "Object Storage" tool to provision them.
PRIVATE_OBJECT_DIR=/your-bucket/private
PUBLIC_OBJECT_SEARCH_PATHS=/your-bucket/public

# --- Auth (Clerk) ---
CLERK_SECRET_KEY=
# agri-web (Vite): VITE_CLERK_PUBLISHABLE_KEY, VITE_CLERK_PROXY_URL
# agri-mobile (Expo): CLERK_PUBLISHABLE_KEY, CLERK_PROXY_URL (mapped to
#   EXPO_PUBLIC_* by the mobile package's own dev script)

# --- Mobile app reaching the API server (agri-mobile) ---
# The mobile app can't rely on same-origin requests like the web app can —
# point it at wherever artifacts/api-server ends up reachable (a Bolt
# preview URL, a deployed URL, etc.)
EXPO_PUBLIC_API_URL=

# --- Mobile money (unchanged — no Replit dependency) ---
MOMO_ENABLED=false
MOMO_MTN_API_KEY=
MOMO_MTN_API_USER=
MOMO_MTN_BASE_URL=
MOMO_MTN_CALLBACK_URL=
MOMO_MTN_SUBSCRIPTION_KEY=
MOMO_MTN_TARGET_ENV=
MOMO_AIRTEL_BASE_URL=
MOMO_AIRTEL_CLIENT_ID=
MOMO_AIRTEL_CLIENT_SECRET=
MOMO_AIRTEL_COUNTRY=
MOMO_AIRTEL_CURRENCY=
MOMO_AIRTEL_PIN=
MOMO_CALLBACK_SECRET=

# --- Misc ---
LOG_LEVEL=info
NODE_ENV=development
